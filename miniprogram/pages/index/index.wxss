.page {
  min-height: 100vh;
  padding-bottom: 130rpx;
  background: #fff9f1;
}

.topbar {
  padding-right: 190rpx;
  padding-bottom: 22rpx;
  padding-left: 40rpx;
}

.topbar-title {
  height: 88rpx;
  color: #51483f;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 88rpx;
  white-space: nowrap;
}

.page-content {
  padding: 0 32rpx 28rpx;
}

.pet-info-card {
  padding: 28rpx 32rpx 30rpx;
  border: 1rpx solid #f2e8d9;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 10rpx 30rpx rgba(108, 86, 56, 0.07);
}

.pet-info-heading,
.experience-labels,
.status-heading,
.status-label {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.pet-name {
  color: #51483f;
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1.3;
}

.pet-subtitle {
  margin-top: 6rpx;
  color: #9a8f81;
  font-size: 23rpx;
}

.level-badge {
  padding: 11rpx 22rpx;
  border-radius: 999rpx;
  background: #fff1d8;
  color: #9b7131;
  font-size: 23rpx;
  font-weight: 700;
}

.experience-labels {
  margin-top: 28rpx;
  color: #857a6d;
  font-size: 22rpx;
}

.experience-labels text:first-child {
  color: #766b5e;
  font-weight: 600;
}

.progress-track,
.status-track {
  overflow: hidden;
  border-radius: 999rpx;
  background: #f3eee6;
}

.progress-track {
  height: 18rpx;
  margin-top: 14rpx;
}

.progress-value {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #f6cc78, #efb84d);
}

.stage {
  position: relative;
  display: flex;
  height: 590rpx;
  margin-top: 28rpx;
  overflow: hidden;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 42rpx;
  background: linear-gradient(180deg, #fff3dc 0%, #fff8e9 55%, #e9f1df 100%);
}

.stage-cloud {
  position: absolute;
  top: 38rpx;
  opacity: 0.78;
  font-size: 64rpx;
}

.cloud-left {
  left: 36rpx;
}

.cloud-right {
  top: 74rpx;
  right: 34rpx;
  font-size: 48rpx;
}

.stage-flower,
.stage-grass {
  position: absolute;
  z-index: 1;
}

.stage-flower {
  top: 52%;
  color: #e8a77f;
  font-size: 38rpx;
}

.flower-left {
  left: 38rpx;
}

.flower-right {
  right: 38rpx;
}

.stage-grass {
  bottom: 86rpx;
  font-size: 30rpx;
}

.grass-left {
  left: 72rpx;
}

.grass-right {
  right: 72rpx;
}

.sheep {
  position: relative;
  z-index: 2;
  transition: transform 180ms ease-out;
}

.sheep-enlarged {
  transform: scale(1.09);
}

.sheep-pressed {
  opacity: 0.92;
}

.sheep-circle {
  display: flex;
  width: 360rpx;
  height: 360rpx;
  align-items: center;
  justify-content: center;
  border: 8rpx solid rgba(255, 255, 255, 0.82);
  border-radius: 50%;
  background: radial-gradient(circle at 35% 28%, #fffefa, #fff4e2 76%);
  box-shadow: 0 20rpx 44rpx rgba(119, 93, 56, 0.13);
}

.sheep-emoji {
  font-size: 190rpx;
  line-height: 1;
}

.speech-bubble {
  position: relative;
  z-index: 3;
  min-width: 250rpx;
  margin-top: 22rpx;
  padding: 15rpx 30rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 6rpx 18rpx rgba(108, 86, 56, 0.08);
  color: #746653;
  font-size: 25rpx;
  font-weight: 600;
  text-align: center;
}

.status-row {
  display: flex;
  margin-top: 26rpx;
  justify-content: space-between;
}

.status-card {
  width: 48%;
  padding: 24rpx 24rpx 22rpx;
  border: 1rpx solid #f2e8d9;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 10rpx 30rpx rgba(108, 86, 56, 0.06);
}

.status-label {
  justify-content: flex-start;
  color: #857a6d;
  font-size: 22rpx;
  font-weight: 600;
}

.status-icon {
  margin-right: 10rpx;
  font-size: 32rpx;
  line-height: 1;
}

.intimacy-icon {
  color: #e88f91;
}

.mood-icon {
  color: #88ad78;
}

.status-value {
  color: #5b5045;
  font-size: 28rpx;
  font-weight: 800;
}

.status-track {
  height: 14rpx;
  margin-top: 20rpx;
}

.status-progress {
  height: 100%;
  border-radius: inherit;
}

.intimacy-progress {
  background: #ef9e9a;
}

.mood-progress {
  background: #a9c89a;
}

.actions {
  margin-top: 26rpx;
}

.action-row {
  display: flex;
  justify-content: space-between;
}

.action-row + .action-row {
  margin-top: 18rpx;
}

.action-card {
  display: flex;
  width: 48%;
  height: 112rpx;
  margin: 0;
  padding: 0 20rpx;
  align-items: center;
  border: 1rpx solid rgba(255, 255, 255, 0.85);
  border-radius: 28rpx;
  color: #655a4d;
  text-align: left;
}

.feed-card {
  background: #fff1d8;
}

.pet-card {
  background: #fde9e4;
}

.chat-card {
  background: #eaf2e4;
}

.task-card {
  background: #f3eddf;
}

.action-icon {
  display: flex;
  width: 66rpx;
  height: 66rpx;
  margin-right: 16rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.82);
  font-size: 34rpx;
}

.action-label {
  font-size: 27rpx;
  font-weight: 700;
}

.action-arrow {
  margin-left: auto;
  color: #b3a797;
  font-size: 38rpx;
  font-weight: 300;
}

.action-hover {
  opacity: 0.82;
  transform: scale(0.98);
}

.bottom-nav {
  position: fixed;
  z-index: 10;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  padding: 16rpx 20rpx calc(14rpx + env(safe-area-inset-bottom));
  justify-content: space-around;
  border-top: 1rpx solid #f0e7dc;
  background: rgba(255, 253, 249, 0.97);
}

.nav-item {
  display: flex;
  min-width: 120rpx;
  flex-direction: column;
  align-items: center;
  color: #a59a8b;
  font-size: 21rpx;
  line-height: 1.35;
}

.nav-icon {
  margin-bottom: 5rpx;
  font-size: 34rpx;
}

.nav-active {
  color: #a77938;
  font-weight: 700;
}
