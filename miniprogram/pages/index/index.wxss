.page {
  min-height: 100vh;
  padding-bottom: 48rpx;
  background: #fff9f1;
}

.topbar {
  padding-right: 190rpx;
  padding-bottom: 22rpx;
  padding-left: 40rpx;
}

.topbar-title {
  height: 88rpx;
  color: #51483f;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 88rpx;
  white-space: nowrap;
}

.page-content {
  padding: 0 32rpx;
}

.pet-info-card {
  padding: 30rpx 32rpx;
  border: 1rpx solid #f2e8d9;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 10rpx 30rpx rgba(108, 86, 56, 0.07);
}

.pet-info-heading,
.experience-labels {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.pet-name {
  color: #51483f;
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1.3;
}

.level-badge {
  padding: 11rpx 22rpx;
  border-radius: 999rpx;
  background: #fff1d8;
  color: #9b7131;
  font-size: 23rpx;
  font-weight: 700;
}

.experience-labels {
  margin-top: 28rpx;
  color: #857a6d;
  font-size: 23rpx;
}

.experience-labels text:first-child {
  color: #766b5e;
  font-weight: 600;
}

.progress-track {
  height: 18rpx;
  margin-top: 14rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #f3eee6;
}

.progress-value {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #f6cc78, #efb84d);
  transition: width 180ms ease-out;
}

.stage {
  position: relative;
  display: flex;
  min-height: 620rpx;
  margin-top: 30rpx;
  overflow: hidden;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 42rpx;
  background: linear-gradient(180deg, #fff3dc 0%, #fff8e9 55%, #e9f1df 100%);
}

.stage-cloud {
  position: absolute;
  top: 38rpx;
  opacity: 0.78;
  font-size: 64rpx;
}

.cloud-left {
  left: 36rpx;
}

.cloud-right {
  top: 74rpx;
  right: 34rpx;
  font-size: 48rpx;
}

.stage-flower,
.stage-grass {
  position: absolute;
  z-index: 1;
}

.stage-flower {
  top: 52%;
  color: #e8a77f;
  font-size: 38rpx;
}

.flower-left {
  left: 38rpx;
}

.flower-right {
  right: 38rpx;
}

.stage-grass {
  bottom: 76rpx;
  font-size: 30rpx;
}

.grass-left {
  left: 72rpx;
}

.grass-right {
  right: 72rpx;
}

.sheep {
  position: relative;
  z-index: 2;
  transition: transform 180ms ease-out;
}

.sheep-enlarged {
  transform: scale(1.09);
}

.sheep-pressed {
  opacity: 0.92;
}

.sheep-circle {
  display: flex;
  width: 380rpx;
  height: 380rpx;
  align-items: center;
  justify-content: center;
  border: 8rpx solid rgba(255, 255, 255, 0.84);
  border-radius: 50%;
  background: radial-gradient(circle at 35% 28%, #fffefa, #fff1d8 78%);
  box-shadow: 0 20rpx 44rpx rgba(119, 93, 56, 0.13);
}

.sheep-emoji {
  font-size: 200rpx;
  line-height: 1;
}

.speech-bubble {
  position: relative;
  z-index: 3;
  min-width: 270rpx;
  margin-top: 24rpx;
  padding: 16rpx 32rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 6rpx 18rpx rgba(108, 86, 56, 0.08);
  color: #746653;
  font-size: 26rpx;
  font-weight: 600;
  text-align: center;
}
