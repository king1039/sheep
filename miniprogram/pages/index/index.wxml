<view class="page">
  <view class="topbar" style="padding-top: {{statusBarHeight}}px;">
    <view class="topbar-title">软洋羊 · 慢慢牧场</view>
  </view>

  <view class="page-content">
    <view class="pet-info-card">
      <view class="pet-info-heading">
        <view class="pet-name">软洋羊</view>
        <view class="level-badge">Lv.{{level}}</view>
      </view>

      <view class="experience-labels">
        <text>经验值</text>
        <text>{{experience}}/{{experienceMax}}</text>
      </view>
      <view class="progress-track">
        <view class="progress-value" style="width: {{experiencePercent}}%;"></view>
      </view>
    </view>

    <view class="stage">
      <view class="stage-cloud cloud-left">☁️</view>
      <view class="stage-cloud cloud-right">☁️</view>
      <view class="stage-flower flower-left">✿</view>
      <view class="stage-flower flower-right">✿</view>
      <view class="stage-grass grass-left">🌱</view>
      <view class="stage-grass grass-right">🌱</view>

      <view
        class="sheep {{isEnlarged ? 'sheep-enlarged' : ''}}"
        hover-class="sheep-pressed"
        bindtap="onSheepTap"
      >
        <view class="sheep-circle">
          <text class="sheep-emoji">🐑</text>
        </view>
      </view>

      <view class="speech-bubble">{{speechText}}</view>
    </view>
  </view>
</view>
